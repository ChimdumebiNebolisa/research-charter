{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-charter:schema:candidate:v1",
  "title": "Research candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "candidate_id",
    "problem_id",
    "target_id",
    "created_at",
    "source_experiment_id",
    "git_commit_sha",
    "artifact_paths",
    "evaluator",
    "claimed_result",
    "validation_status",
    "evidence_level",
    "provenance",
    "limitations"
  ],
  "properties": {
    "record_type": {"const": "candidate"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
    "problem_id": {"enum": ["dts_7_5", "heilbronn_n12", "kserver_k4_circle"]},
    "target_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_experiment_id": {"type": "string", "minLength": 1},
    "git_commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "artifact_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evaluator": {"type": "object", "minProperties": 1},
    "claimed_result": {"type": "object", "minProperties": 1},
    "validation_status": {"enum": ["unverified", "primary_evaluator", "independently_reproduced", "adversarially_verified", "rejected"]},
    "evidence_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "provenance": {"type": "object", "minProperties": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
