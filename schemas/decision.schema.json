{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-charter:schema:decision:v1",
  "title": "Research director decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "decision_id",
    "timestamp",
    "git_commit_sha",
    "review_period",
    "review_questions",
    "allocation_decision",
    "selected_primary_problem_id",
    "selected_hedge_problem_id",
    "actions",
    "evidence_references",
    "human_authorization_status"
  ],
  "properties": {
    "record_type": {"const": "decision"},
    "decision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "git_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40,64}$"},
    "review_period": {"type": "string", "minLength": 1},
    "review_questions": {"type": "object", "minProperties": 9},
    "allocation_decision": {"type": "string", "minLength": 1},
    "selected_primary_problem_id": {"type": ["string", "null"]},
    "selected_hedge_problem_id": {"type": ["string", "null"]},
    "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_references": {"type": "array", "items": {"type": "string"}},
    "human_authorization_status": {"enum": ["not_required_for_record", "pending", "authorized"]}
  }
}
