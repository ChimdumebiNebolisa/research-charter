{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-charter:schema:experiment:v1",
  "title": "Research experiment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "experiment_id",
    "problem_id",
    "target_id",
    "timestamp",
    "parent_experiment_ids",
    "git_commit_sha",
    "hypothesis",
    "rationale",
    "expected_information_gain",
    "method",
    "metric",
    "metric_relation_to_true_objective",
    "configuration",
    "random_seeds",
    "compute_budget",
    "kill_condition",
    "output_artifacts",
    "raw_result",
    "baseline_comparison",
    "previous_best_comparison",
    "evidence_level",
    "interpretation",
    "failure_mode",
    "what_was_learned",
    "recommended_next_action",
    "repetition_justification"
  ],
  "properties": {
    "record_type": {"const": "experiment"},
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
    "problem_id": {"enum": ["dts_7_5", "heilbronn_n12", "kserver_k4_circle"]},
    "target_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "parent_experiment_ids": {"type": "array", "items": {"type": "string"}},
    "git_commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "hypothesis": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "expected_information_gain": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "metric": {"type": "string", "minLength": 1},
    "metric_relation_to_true_objective": {"type": "string", "minLength": 1},
    "configuration": {"type": "object"},
    "random_seeds": {"type": "array", "items": {"type": "integer"}},
    "compute_budget": {"type": "object", "minProperties": 1},
    "kill_condition": {"type": "string", "minLength": 1},
    "output_artifacts": {"type": "array", "items": {"type": "string"}},
    "raw_result": {"type": "object"},
    "baseline_comparison": {"type": "object", "minProperties": 1},
    "previous_best_comparison": {"type": "object", "minProperties": 1},
    "evidence_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "interpretation": {"type": "string", "minLength": 1},
    "failure_mode": {"type": ["string", "null"]},
    "what_was_learned": {"type": "string", "minLength": 1},
    "recommended_next_action": {"type": "string", "minLength": 1},
    "repetition_justification": {"type": ["string", "null"]}
  }
}
